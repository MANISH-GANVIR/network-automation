# ============================================================
# ANSIBLE PLAYBOOK CHEAT SHEET (Python TXT Style)
# Topic: Ad-hoc to Playbook, gather_facts, register, debug
# ============================================================

# 1) WHAT IS A PLAYBOOK
# - A YAML file with one or more plays
# - Each play = target hosts + tasks
# - Reusable, readable, repeatable automation

# 2) BASIC PLAY STRUCTURE
# ---
# - name: Play name
#   hosts: group_or_host
#   gather_facts: false
#   tasks:
#     - name: Task name
#       module_name:
#         key: value

# 3) IMPORTANT FIELDS
# - name         -> Human-readable play/task name
# - hosts        -> Inventory group or host target
# - gather_facts -> true (default) / false
# - tasks        -> Ordered list of actions
# - register     -> Saves module output into a variable

# 4) BEST PRACTICE
# - Use FQCN (Fully Qualified Collection Name) modules:
#   cisco.ios.ios_command
#   cisco.nxos.nxos_command
#   arista.eos.eos_command

# 5) SINGLE PLAY EXAMPLE (Cisco IOS)
---
- name: Run show version on Cisco IOS
  hosts: cisco_ios
  gather_facts: false

  tasks:
    - name: Run show version
      cisco.ios.ios_command:
        commands:
          - show version
      register: ios_out

    - name: Display output
      ansible.builtin.debug:
        var: ios_out
...

# 6) IMPORTANT REGISTER OUTPUT KEYS
# ios_out.changed      -> Whether configuration changed
# ios_out.failed       -> Whether task failed
# ios_out.stdout       -> Raw command output (list)
# ios_out.stdout_lines -> Line-by-line output (structured)

# 7) GATHER FACTS
# - Default: true (Ansible runs "Gathering Facts" automatically)
# - If not needed, set:
#   gather_facts: false
# - Facts variable name:
#   ansible_facts

# 8) PRINT FACTS
---
- name: Show facts
  hosts: cisco_ios
  gather_facts: true

  tasks:
    - name: Print ansible_facts
      ansible.builtin.debug:
        var: ansible_facts
...

# 9) MULTI-PLAY EXAMPLE (IOS + NXOS + EOS)
---
- name: Show version - Cisco IOS
  hosts: cisco_ios
  gather_facts: false
  tasks:
    - name: Run show version on IOS
      cisco.ios.ios_command:
        commands: [show version]
      register: ios_out
    - name: Print IOS output
      ansible.builtin.debug:
        var: ios_out.stdout_lines

- name: Show version - Cisco NXOS
  hosts: cisco_nxos
  gather_facts: false
  tasks:
    - name: Run show version on NXOS
      cisco.nxos.nxos_command:
        commands: [show version]
      register: nxos_out
    - name: Print NXOS output
      ansible.builtin.debug:
        var: nxos_out.stdout_lines

- name: Show version - Arista EOS
  hosts: arista_eos
  gather_facts: false
  tasks:
    - name: Run show version on EOS
      arista.eos.eos_command:
        commands: [show version]
      register: eos_out
    - name: Print EOS output
      ansible.builtin.debug:
        var: eos_out.stdout_lines
...

# 10) RUN COMMANDS
# Run playbook:
# ansible-playbook playbooks/show_version.yml
#
# If inventory path is not set in ansible.cfg:
# ansible-playbook -i inventory/inventory.yml playbooks/show_version.yml

# 11) EXECUTION BEHAVIOR
# - Tasks run in order
# - Same task runs on all matched hosts
# - If a task fails on one host, that host is removed from remaining tasks in that play

# 12) QUICK TROUBLESHOOTING CHECKLIST
# - Is the inventory group name correct? (hosts: cisco_ios, etc.)
# - Is module FQCN correct?
# - Set gather_facts: false if not required
# - Not seeing command output? Use register + debug
# - Are connection vars set? (ansible_connection, ansible_user, ansible_password)

